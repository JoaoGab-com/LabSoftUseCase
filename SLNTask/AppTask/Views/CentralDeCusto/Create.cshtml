@model AppTask.Models.CentralDeCusto

@{
    ViewData["Title"] = "Nova Central de Custo";
}

<div class="container mt-4">
    <h1>Nova Central de Custo</h1>
    <hr />

    <div class="row">
        <div class="col-md-4">
            <form action="/CentralDeCusto/Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="NomeCentral" class="form-label">
                        Nome da Central
                    </label>
                    <input type="text" name="NomeCentral"
                           id="NomeCentral" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-primary">
                    Salvar
                </button>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a href="/CentralDeCusto/Index" class="btn btn-secondary">
            Voltar para a lista
        </a>
    </div>
</div>

