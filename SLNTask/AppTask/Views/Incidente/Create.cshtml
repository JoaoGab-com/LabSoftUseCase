@model AppTask.Models.Incidente

@{
    ViewData["Title"] = "Novo Incidente";
}

<div class="container mt-4">
    <h1>Novo Incidente</h1>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form action="/Incidente/Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="DescricaoProblema" class="form-label">
                        Descrição do Problema
                    </label>
                    <textarea name="DescricaoProblema"
                              id="DescricaoProblema"
                              class="form-control" required></textarea>
                </div>

                <div class="mb-3">
                    <label for="DataIncidente" class="form-label">
                        Data do Incidente
                    </label>
                    <input type="datetime-local"
                           name="DataIncidente"
                           id="DataIncidente"
                           class="form-control" required />
                </div>

                <div class="mb-3">
                    <label for="Solucao" class="form-label">Solução</label>
                    <textarea name="Solucao" id="Solucao"
                              class="form-control"></textarea>
                </div>

                <div class="mb-3">
                    <label for="Resolvido" class="form-label">Resolvido</label>
                    <select name="Resolvido" id="Resolvido"
                            class="form-select">
                        <option value="false">Não</option>
                        <option value="true">Sim</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Salvar
                </button>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a href="/Incidente/Index" class="btn btn-secondary">
            Voltar para a lista
        </a>
    </div>
</div>